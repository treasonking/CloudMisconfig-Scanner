<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CloudMisconfig Dashboard</title>
  <style>
    :root {
      --bg: #f3f7fb;
      --card: #ffffff;
      --line: #d8e2ee;
      --text: #10233a;
      --muted: #5f738d;
      --ok: #0f7a33;
      --warn: #b91c1c;
      --btn: #0059b3;
    }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: "Segoe UI", "Noto Sans KR", sans-serif; }
    .wrap { max-width: 1100px; margin: 24px auto; padding: 0 16px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; margin-bottom: 16px; }
    h1, h2 { margin: 0 0 12px; }
    .muted { color: var(--muted); }
    .btn { display: inline-block; text-decoration: none; color: #fff; background: var(--btn); border-radius: 10px; padding: 8px 14px; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .metric { background: #f8fbff; border: 1px solid var(--line); border-radius: 10px; padding: 10px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); }
    th { background: #f6f9fd; }
    .status-fail { color: var(--warn); font-weight: 700; }
    .status-pass { color: var(--ok); font-weight: 700; }
    @media (max-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>CloudMisconfig Dashboard</h1>
      <p class="muted">최근 스캔 결과와 리포트 파일을 빠르게 확인합니다.</p>
      <a class="btn" href="/scan?profile={{ profile }}&region={{ region }}">지금 스캔 실행</a>
    </div>

    <div class="card">
      <h2>Latest Summary</h2>
      <div class="grid">
        <div class="metric"><strong>Total</strong><div>{{ summary.total }}</div></div>
        <div class="metric"><strong>FAIL</strong><div class="status-fail">{{ summary.fail }}</div></div>
        <div class="metric"><strong>PASS</strong><div class="status-pass">{{ summary.pass }}</div></div>
        <div class="metric"><strong>Errors</strong><div>{{ summary.errors }}</div></div>
      </div>
    </div>

    <div class="card">
      <h2>Recent Reports</h2>
      <table>
        <thead>
          <tr>
            <th>Filename</th>
            <th>Type</th>
            <th>Size(bytes)</th>
            <th>Open</th>
          </tr>
        </thead>
        <tbody>
          {% for r in reports %}
          <tr>
            <td>{{ r.filename }}</td>
            <td>{{ r.type }}</td>
            <td>{{ r.size }}</td>
            <td><a href="/report/{{ r.filename }}">보기</a></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
