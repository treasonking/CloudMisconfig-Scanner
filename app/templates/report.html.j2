<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Cloud Misconfig Report</title>
  <style>
    :root {
      --bg: #f4f7fb;
      --card: #ffffff;
      --line: #dbe3ee;
      --text: #122033;
      --muted: #5f7088;
      --critical: #8b0000;
      --high: #b93815;
      --medium: #9a6700;
      --low: #325d1d;
      --pass: #0f7a33;
      --fail: #b91c1c;
    }
    body {
      margin: 0;
      background: linear-gradient(145deg, #eef4fb 0%, #f7fafc 100%);
      font-family: "Segoe UI", "Noto Sans KR", sans-serif;
      color: var(--text);
    }
    .wrap {
      max-width: 1000px;
      margin: 24px auto;
      padding: 0 16px;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: 0 8px 24px rgba(26, 54, 93, 0.07);
    }
    h1, h2 { margin: 0 0 12px; }
    .meta { color: var(--muted); font-size: 14px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; border-bottom: 1px solid var(--line); padding: 10px 8px; vertical-align: top; }
    th { background: #f6f9fd; }
    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .findings-table {
      width: 100%;
      min-width: 920px;
      table-layout: fixed;
    }
    .findings-table th:nth-child(1), .findings-table td:nth-child(1) { width: 80px; }
    .findings-table th:nth-child(2), .findings-table td:nth-child(2) { width: 90px; }
    .findings-table th:nth-child(3), .findings-table td:nth-child(3) { width: 180px; }
    .findings-table th:nth-child(4), .findings-table td:nth-child(4) { width: 220px; }
    .findings-table th:nth-child(5), .findings-table td:nth-child(5) { width: 280px; }
    .findings-table th:nth-child(6), .findings-table td:nth-child(6) { width: 220px; }
    .status-PASS { color: var(--pass); font-weight: 700; }
    .status-FAIL { color: var(--fail); font-weight: 700; }
    .sev-CRITICAL { color: var(--critical); font-weight: 700; }
    .sev-HIGH { color: var(--high); font-weight: 700; }
    .sev-MEDIUM { color: var(--medium); font-weight: 700; }
    .sev-LOW, .sev-INFO { color: var(--low); font-weight: 700; }
    .pill {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      background: #eef2ff;
      border: 1px solid #dbe3ee;
      font-size: 12px;
      margin-right: 6px;
      margin-bottom: 4px;
    }
    .mono {
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
      color: #1f2937;
      white-space: pre-wrap;
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 6px;
      margin-top: 6px;
    }
    .analysis-item {
      margin-bottom: 6px;
      line-height: 1.4;
      color: var(--text);
    }
    .analysis-item b {
      display: inline-block;
      min-width: 120px;
      color: #334155;
      font-size: 12px;
    }
    details summary {
      cursor: pointer;
      color: #1d4ed8;
      font-size: 13px;
      user-select: none;
    }
    .warn {
      color: #b45309;
      font-weight: 600;
    }
    .ok {
      color: #166534;
      font-weight: 600;
    }
    .outcome-TP, .outcome-TN { color: #166534; font-weight: 700; }
    .outcome-FP, .outcome-FN, .outcome-NOT_EVALUATED, .outcome-UNKNOWN_EXPECTED { color: #b91c1c; font-weight: 700; }
    .mini-table th, .mini-table td { font-size: 13px; }
    @media (max-width: 1100px) {
      .wrap {
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Cloud Misconfiguration Report</h1>
      <div class="meta">Provider: {{ context.provider }} | Region: {{ context.region }} | Profile: {{ context.profile or '-' }}</div>
      <div class="meta">Started At (UTC): {{ context.started_at }}</div>
      <div class="meta">Total Findings: {{ summary.total }} | FAIL: {{ summary.fail }} | PASS: {{ summary.pass }}</div>
      <div class="meta">CRITICAL: {{ summary.critical }} | HIGH: {{ summary.high }} | MEDIUM: {{ summary.medium }} | LOW: {{ summary.low }} | INFO: {{ summary.info }}</div>
    </div>

    <div class="card">
      <h2>Test Scope</h2>
      <div class="meta">총 테스트 대상 수: {{ test_scope.total_cases }}</div>
      <div class="meta">정상 케이스: {{ test_scope.normal_cases }} | 오설정 케이스: {{ test_scope.misconfigured_cases }}</div>
      <div class="meta">정상/비정상 비교 시연을 위해 PASS/FAIL 결과를 함께 기록했습니다.</div>
      {% if scope_warnings %}
      <div style="margin-top:8px;">
        {% for w in scope_warnings %}
        <div class="meta warn">- {{ w }}</div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="card">
      <h2>Detection Quality</h2>
      {% if detection_quality.available %}
      <div class="meta">탐지 성공 수(TP): {{ detection_quality.detected_success }}</div>
      <div class="meta">오탐 수(FP): {{ detection_quality.false_positives }}</div>
      <div class="meta">미탐 수(FN): {{ detection_quality.missed_detections }}</div>
      <div class="meta">미평가 수(Not Evaluated): {{ detection_quality.not_evaluated }}</div>
      <div class="meta">Precision: {{ detection_quality.precision }} | Recall: {{ detection_quality.recall }}</div>
      <div class="meta">평가 대상: {{ detection_quality.total_cases }} (정상 {{ detection_quality.normal_cases }} / 오설정 {{ detection_quality.misconfigured_cases }})</div>
      <div class="meta">Benchmark Coverage: {{ detection_quality.total_cases }} / {{ test_scope.total_cases }} ({{ ((detection_quality.total_cases / test_scope.total_cases) * 100) | round(1) if test_scope.total_cases > 0 else 0 }}%)</div>
      {% else %}
      <div class="meta">{{ detection_quality.message }}</div>
      <div class="meta">팁: `--benchmark-file`로 기대 결과(정상/오설정)를 넣으면 오탐/미탐을 자동 계산합니다.</div>
      {% endif %}
    </div>

    <div class="card">
      <h2>Expected vs Actual Matrix</h2>
      {% if case_matrix.available %}
      {% if case_matrix.mismatch_count > 0 %}
      <div class="meta warn">불일치 {{ case_matrix.mismatch_count }}건 발견: 정답셋과 실제 AWS 상태 또는 규칙을 확인하세요.</div>
      {% else %}
      <div class="meta ok">정답셋과 실제 탐지 결과가 모두 일치합니다.</div>
      {% endif %}
      <div class="table-wrap" style="margin-top:8px;">
        <table class="mini-table" style="min-width:860px;">
          <thead>
            <tr>
              <th>#</th>
              <th>Check ID</th>
              <th>Resource</th>
              <th>Expected</th>
              <th>Actual</th>
              <th>Outcome</th>
              <th>Note</th>
            </tr>
          </thead>
          <tbody>
            {% for c in case_matrix.cases %}
            <tr>
              <td>{{ c.index }}</td>
              <td>{{ c.check_id }}</td>
              <td>{{ c.resource }}</td>
              <td>{{ c.expected }}</td>
              <td>{{ c.actual }}</td>
              <td class="outcome-{{ c.outcome }}">{{ c.outcome }}</td>
              <td>{{ c.note or '-' }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="meta">{{ case_matrix.message }}</div>
      {% endif %}
    </div>

    {% if errors %}
    <div class="card">
      <h2>Errors</h2>
      <ul>
        {% for err in errors %}
        <li>{{ err }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <div class="card">
      <h2>Findings</h2>
      <div class="table-wrap">
        <table class="findings-table">
          <thead>
            <tr>
              <th>Status</th>
              <th>Severity</th>
              <th>Check ID</th>
              <th>Resource</th>
              <th>Analysis</th>
              <th>Evidence</th>
            </tr>
          </thead>
          <tbody>
            {% for f in findings %}
            <tr>
              <td class="status-{{ f.status }}">{{ f.status }}</td>
              <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
              <td>{{ f.check_id }}</td>
              <td>{{ f.resource }}</td>
              <td>
                <div class="analysis-item"><b>Reason</b>{{ f.reason }}</div>
                <div class="analysis-item"><b>Risk</b>{{ f.risk }}</div>
                <div class="analysis-item"><b>Recommendation</b>{{ f.recommendation or '-' }}</div>
              </td>
              <td>
                {% if f.evidence %}
                <details>
                  <summary>View JSON</summary>
                  <div class="mono">{{ to_json(f.evidence) }}</div>
                </details>
                {% else %}
                -
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>Known Limitations</h2>
      {% for item in limitations %}
      <span class="pill">{{ item }}</span>
      {% endfor %}
    </div>

    <div class="card">
      <h2>Improvement Directions</h2>
      {% for item in improvements %}
      <span class="pill">{{ item }}</span>
      {% endfor %}
    </div>
  </div>
</body>
</html>
